{
	"name": "flexible-table-block",
	"version": "3.9.0",
	"description": "The custom block plugin for the WordPress block editor that allows you to create tables with flexible configurations.",
	"author": "Aki Hamano",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"gutenberg",
		"block",
		"table"
	],
	"homepage": "https://github.com/t-hamano/flexible-table-block",
	"repository": "git+https://github.com/t-hamano/flexible-table-block.git",
	"bugs": {
		"url": "https://github.com/t-hamano/flexible-table-block/issues"
	},
	"engines": {
		"node": ">=24.22.1",
		"npm": ">=11.19.1"
	},
	"files": [
		"classes",
		"src",
		"build",
		"flexible-table-block.php",
		"uninstall.php",
		"readme.txt"
	],
	"dependencies": {
		"@wordpress/icons": "^19.0.0",
		"@wordpress/ui": "0.25.0",
		"postcss-value-parser": "4.2.0"
	},
	"devDependencies": {
		"@types/node": "24.19.2",
		"@types/react": "18.3.31",
		"@types/wordpress__block-editor": "^15.0.8",
		"@wordpress/api-fetch": "8.0.0",
		"@wordpress/base-styles": "14.0.0",
		"@wordpress/block-editor": "19.0.0",
		"@wordpress/blocks": "17.0.0",
		"@wordpress/components": "43.0.0",
		"@wordpress/compose": "9.0.0",
		"@wordpress/core-data": "9.0.0",
		"@wordpress/data": "11.0.0",
		"@wordpress/element": "10.0.0",
		"@wordpress/env": "^12.0.0",
		"@wordpress/eslint-plugin": "28.0.0",
		"@wordpress/i18n": "6.30.0",
		"@wordpress/keycodes": "5.0.0",
		"@wordpress/notices": "6.0.0",
		"@wordpress/scripts": "^37.0.0",
		"clsx": "2.1.1",
		"cross-env": "10.1.0",
		"csstype": "3.2.3",
		"eslint-import-resolver-typescript": "^4.4.5",
		"husky": "^9.1.7",
		"jsdom": "30.1.3",
		"lint-staged": "17.6.0",
		"prettier": "npm:wp-prettier@3.9.6",
		"redux": "5.0.1",
		"rimraf": "6.1.3",
		"typescript": "6.0.3",
		"vite": "8.3.5",
		"vitest": "5.0.5"
	},
	"scripts": {
		"wp-env": "wp-env",
		"wp-env-test": "wp-env --config .wp-env.test.json",
		"start": "wp-scripts start",
		"build": "wp-scripts build",
		"plugin-zip": "npm run build && wp-scripts plugin-zip",
		"check-licenses": "wp-scripts check-licenses",
		"lint": "npm run lint:css && npm run lint:js && npm run lint:types && npm run lint:php && npm run lint:md-docs && npm run lint:pkg-json",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js",
		"lint:types": "tsc",
		"lint:php": "vendor/bin/phpcs",
		"lint:md-docs": "wp-scripts lint-md-docs",
		"lint:pkg-json": "wp-scripts lint-pkg-json",
		"format": "wp-scripts format",
		"test:unit": "wp-scripts test-unit-js --config test/unit/vitest.config.mjs",
		"fixtures:clean": "rimraf --glob \"test/integration/fixtures/*.{json,serialized.html}\"",
		"fixtures:generate": "cross-env GENERATE_MISSING_FIXTURES=y npm run test:unit -- --project integration",
		"fixtures:regenerate": "npm run fixtures:clean && npm run fixtures:generate",
		"test:e2e": "wp-scripts test-playwright --wp-env-config=.wp-env.test.json",
		"test:e2e:debug": "wp-scripts test-playwright --wp-env-config=.wp-env.test.json --debug",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{js,json,ts,tsx,yml,yaml}": [
			"wp-scripts format"
		],
		"*.{js,ts,tsx}": [
			"wp-scripts lint-js"
		],
		"*.scss": [
			"wp-scripts lint-style"
		],
		"*.md": [
			"wp-scripts lint-md-docs"
		],
		"package.json": [
			"wp-scripts lint-pkg-json"
		]
	}
}
